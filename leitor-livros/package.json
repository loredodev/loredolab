{
  "name": "leitor-loredo",
  "productName": "Leitor Loredo",
  "version": "1.0.0",
  "description": "Leitor de livros completo para PC: EPUB, PDF, MOBI, AZW3, FB2, CBZ/CBR, DOCX, ODT, RTF, TXT, Markdown e HTML, com anotações, tradução, flashcards e estatísticas.",
  "main": "main.js",
  "author": "LoredoLab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.loredolab.leitor",
    "productName": "Leitor Loredo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "!node_modules/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF",
        "role": "Viewer"
      },
      {
        "ext": "mobi",
        "name": "MOBI",
        "role": "Viewer"
      },
      {
        "ext": "azw3",
        "name": "Kindle AZW3",
        "role": "Viewer"
      },
      {
        "ext": "azw",
        "name": "Kindle AZW",
        "role": "Viewer"
      },
      {
        "ext": "fb2",
        "name": "FictionBook",
        "role": "Viewer"
      },
      {
        "ext": "cbz",
        "name": "Comic Book ZIP",
        "role": "Viewer"
      },
      {
        "ext": "cbr",
        "name": "Comic Book RAR",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Leitor Loredo"
    },
    "portable": {
      "artifactName": "LeitorLoredo-Portatil-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.books"
    }
  }
}
